# Generate a separate game access token: python -c "import secrets; print(secrets.token_urlsafe(32))"
VOYAGER_ACCESS_TOKEN=
# Exact front-end origins, comma separated; add your own HTTPS origin if needed.
VOYAGER_ALLOWED_ORIGINS=
# Provider credentials belong on the server only. Do not enter them in the webpage.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
# Set an actual API model ID available to your provider/account.
MODEL_ID=
REVIEW_MODEL_ID=
MODEL_PROTOCOL=responses
MODEL_MAX_OUTPUT_TOKENS=10000
MODEL_TIMEOUT_SECONDS=120
