{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voyager:content_package:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "package_id",
    "namespace",
    "version",
    "dependencies",
    "compatibility",
    "migration_notes",
    "migrations",
    "definitions",
    "content_sha256",
    "source",
    "visibility"
  ],
  "properties": {
    "schema": {
      "const": "VOYAGER_CONTENT_PACKAGE_V2"
    },
    "schema_version": {
      "const": 2
    },
    "package_id": {},
    "namespace": {},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "engine",
        "schema_versions"
      ],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string"
        },
        "schema_versions": {
          "const": [
            2
          ]
        }
      }
    },
    "migration_notes": {},
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op",
          "definition_id",
          "from_version"
        ],
        "additionalProperties": false,
        "properties": {
          "op": {
            "const": "retain_version"
          },
          "definition_id": {
            "type": "string"
          },
          "from_version": {
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "data",
          "tags",
          "priority",
          "visibility",
          "status",
          "conflict_key"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "location",
              "organization",
              "equipment",
              "scene_family",
              "semantic_rule"
            ]
          },
          "title": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "maxItems": 12
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "visibility": {
            "enum": [
              "player",
              "gm",
              "definition_only"
            ]
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "conflict_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {},
    "visibility": {}
  },
  "description": "Authoritative executable validator: _s4_validate_package. Kind data schemas and range constraints are strictly checked there; no scripts/prices/paths."
}
